<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Provider Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProviderAssignmentStarter.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="state-top-bar">
        <div class="container-fluid">
            <span class="state-top-left"></span>
            <span class="state-top-right"></span>
        </div>
    </div>

    <header class="site-header">
        <div class="container-fluid px-3 px-md-4">
            <a asp-controller="Home" asp-action="Index" class="header-brand">
                <div class="brand-icon">&#127775;</div>
                <div class="brand-text">
                    <h1></h1>
                    <p>Department of Early Care and Learning &mdash; Provider Management</p>
                </div>
            </a>
        </div>
    </header>

    <div class="site-nav">
        <div class="container-fluid px-3 px-md-4">
            <nav class="navbar navbar-expand-sm">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Providers" asp-action="Index">Providers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Reports" asp-action="Index">Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard">Analytics Dashboard</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </div>

    <div class="main-content">
        <div class="container-fluid px-3 px-md-4">
            @RenderBody()
        </div>
    </div>

    <footer class="site-footer">
        <div class="container-fluid px-3 px-md-4">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <p class="footer-heading"></p>
                    <address>
                        <br />
                       <br />
                       
                    </address>
                </div>
                <div class="col-md-4 mb-4">
                    <p class="footer-heading">Quick Links</p>
                    <ul>
                        <li><a asp-area="" asp-controller="Providers" asp-action="Index">Providers</a></li>
                        <li><a asp-area="" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        <li><a href="/dashboard">Analytics Dashboard</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <p class="footer-heading">Contact</p>
                    <p>
                   
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>&copy; Department of Early Care and Learning</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
