@model ProviderAssignmentStarter.Models.ViewModels.ProviderFormViewModel
@{
    ViewData["Title"] = "Add Provider";
}

<div class="page-header-bar">
    <div class="container-fluid px-3 px-md-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-decal">
                <li class="breadcrumb-item"><a asp-action="Index">Providers</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add Provider</li>
            </ol>
        </nav>
        <h2>Add New Provider</h2>
        <p class="page-subtitle">Register a new child care provider</p>
    </div>
</div>

<div class="container-fluid px-3 px-md-4">
    <div class="row">
        <div class="col-md-6 col-lg-5">
            <div class="card">
                <div class="card-header decal-primary">Provider Information</div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        @if (Model.ExistingProviderId.HasValue)
                        {
                            <div class="alert alert-warning mb-3">
                                <a asp-action="Details" asp-route-id="@Model.ExistingProviderId.Value" class="alert-link">View existing provider</a>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="ProviderName" class="form-label"></label>
                            <input asp-for="ProviderName" class="form-control" />
                            <span asp-validation-for="ProviderName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="County" class="form-label"></label>
                            <input asp-for="County" class="form-control" />
                            <span asp-validation-for="County" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select"
                                    asp-items="@(new SelectList(ProviderAssignmentStarter.Models.ViewModels.ProviderFormViewModel.StatusOptions))">
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-decal-gold">Create Provider</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
