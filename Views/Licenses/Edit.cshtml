@model ProviderAssignmentStarter.Models.ViewModels.LicenseFormViewModel
@{
    ViewData["Title"] = "Edit License";
}

<div class="page-header-bar">
    <div class="container-fluid px-3 px-md-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-decal">
                <li class="breadcrumb-item"><a asp-controller="Providers" asp-action="Index">Providers</a></li>
                <li class="breadcrumb-item"><a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId">@Model.ProviderName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit License</li>
            </ol>
        </nav>
        <h2>Edit License</h2>
        <p class="page-subtitle">Update license record for @Model.ProviderName</p>
    </div>
</div>

<div class="container-fluid px-3 px-md-4">
    <div class="row">
        <div class="col-md-6 col-lg-5">
            <div class="card">
                <div class="card-header decal-primary">License Information</div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input asp-for="LicenseId" type="hidden" />
                        <input asp-for="ProviderId" type="hidden" />
                        <input asp-for="ProviderName" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="LicenseNumber" class="form-label"></label>
                            <input asp-for="LicenseNumber" class="form-control" />
                            <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LicenseStatus" class="form-label"></label>
                            <select asp-for="LicenseStatus" class="form-select"
                                    asp-items="@(new SelectList(ProviderAssignmentStarter.Models.ViewModels.LicenseFormViewModel.StatusOptions))">
                            </select>
                            <span asp-validation-for="LicenseStatus" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpirationDate" class="form-label"></label>
                            <input asp-for="ExpirationDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-decal-gold">Save Changes</button>
                            <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
